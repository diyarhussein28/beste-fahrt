# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا يُرفع .env إلى Git أبداً.

# --- Database ---
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fleet_dispatch
DATABASE_URL=postgresql+asyncpg://fleet:change_me@db:5432/fleet_dispatch

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Platform credentials (Collector) ---
PLATFORM_USERNAME=
PLATFORM_PASSWORD=
STATE_FILE=/data/storage_state.json

# --- Telegram Dispatcher ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# --- Geocoding ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=

# --- Config file path ---
CONFIG_PATH=/app/config.yaml

# --- Admin panel ---
ADMIN_SECRET_KEY=change_me
