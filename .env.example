# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا يُرفع .env إلى Git أبداً.

# --- Database ---
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fleet_dispatch
DATABASE_URL=postgresql+asyncpg://fleet:change_me@db:5432/fleet_dispatch

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Platform credentials (Collector) ---
# One username/password pair per platform listed in config.yaml's
# `platforms:` — name it PLATFORM_<NAME IN CAPS>_USERNAME/_PASSWORD, e.g.
# for a platform entry named "movacarpro":
PLATFORM_MOVACARPRO_USERNAME=
PLATFORM_MOVACARPRO_PASSWORD=
# Add another pair per additional platform you enable in config.yaml, e.g.
# PLATFORM_ANOTHER_PLATFORM_USERNAME=
# PLATFORM_ANOTHER_PLATFORM_PASSWORD=

STATE_FILE=/data/storage_state.json
# Optional: key used to encrypt the session file at rest. If left empty it is
# derived from ADMIN_SECRET_KEY — set this explicitly in production.
STATE_ENC_KEY=
# demo (synthetic offers, no real platform touched) or live (polls every
# enabled entry in config.yaml's `platforms:` list)
COLLECTOR_MODE=demo

# --- Telegram Dispatcher ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# --- Geocoding ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=

# --- Config file path ---
CONFIG_PATH=/app/config.yaml

# --- Admin panel ---
ADMIN_SECRET_KEY=change_me
